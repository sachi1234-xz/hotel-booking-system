{
  "info": {
    "name": "Booking Service",
    "description": "CRUD API for hotel bookings backed by MongoDB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "bookingId", "value": "" }
  ],
  "item": [
    {
      "name": "Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.collectionVariables.set('bookingId', jsonData.id);",
              "pm.test('Status is 201', function () { pm.response.to.have.status(201); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"guestName\": \"Nimal Perera\",\n  \"roomNumber\": \"101\",\n  \"checkInDate\": \"2026-09-01\",\n  \"checkOutDate\": \"2026-09-05\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
      }
    },
    {
      "name": "Get All Bookings",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"] }
      }
    },
    {
      "name": "Get Booking By Id",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "bookings", "{{bookingId}}"]
        }
      }
    },
    {
      "name": "Search Bookings by Room",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/bookings?roomNumber=101",
          "host": ["{{baseUrl}}"],
          "path": ["api", "bookings"],
          "query": [{ "key": "roomNumber", "value": "101" }]
        }
      }
    },
    {
      "name": "Search Bookings by Guest Name",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/bookings?guestName=Nimal",
          "host": ["{{baseUrl}}"],
          "path": ["api", "bookings"],
          "query": [{ "key": "guestName", "value": "Nimal" }]
        }
      }
    },
    {
      "name": "Update Booking",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"guestName\": \"Nimal Perera\",\n  \"roomNumber\": \"102\",\n  \"checkInDate\": \"2026-09-02\",\n  \"checkOutDate\": \"2026-09-06\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "bookings", "{{bookingId}}"]
        }
      }
    },
    {
      "name": "Update Booking Status",
      "request": {
        "method": "PATCH",
        "url": {
          "raw": "{{baseUrl}}/api/bookings/{{bookingId}}/status?status=CHECKED_IN",
          "host": ["{{baseUrl}}"],
          "path": ["api", "bookings", "{{bookingId}}", "status"],
          "query": [{ "key": "status", "value": "CHECKED_IN" }]
        }
      }
    },
    {
      "name": "Delete Booking",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/bookings/{{bookingId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "bookings", "{{bookingId}}"]
        }
      }
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
      }
    }
  ]
}
